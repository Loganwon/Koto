# ===== Koto .gitignore =====

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
build/*.spec
# 例外：Inno Setup 中文语言文件需要随源码一起提交（CI 构建安装包依赖它）
!build/ChineseSimplified.isl

# Virtual environment
.venv/
venv/
env/

# Secrets & API keys
**/gemini_config.env
config/user_settings.json
config/user_profile.json
config/memory.json
config/token_usage.json
config/skill_bindings.json
config/model_setup_done.json
config/koto_checkpoints.sqlite*
config/local_model_prompted.json
config/jwt_secret.txt

# Runtime / personal data (generated at runtime, not for repo)
config/proactive_queue.json
config/shadow_observations.json
config/file_task_summaries.json
config/skill_usage_log.json
config/triggers.json
config/notifications.db
config/proactive_dialogue.db
config/proactive_triggers.db
config/insights.db
config/context_awareness.db
config/knowledge_graph.db
config/concepts.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Logs
logs/
*.log

# Koto runtime temp files
_probe*.txt
_probe*.py
.koto_artifacts/
.koto.lock

# Stale backup files generated by scripts/remove_blueprint_routes.py
web/app.py.bak
test_output.txt
test_doc_output.txt
test_e2e.txt
build_log.txt

# Workspace user data
workspace/
chats/

# Models (large binary files)
models/

# Build artifacts
_archive/
archive/build_logs/
archive/installer_backup/
*.zip
*.exe

# Large binary files
*.fst
*.mdl
*.pdf
*.pptx
*.docx
*.xlsx

# User auth data
config/users.json

# User uploads
web/uploads/

# Node modules (if any)
node_modules/

# WebView2 runtime profile
.webview2_profile/

# pytest local temp dirs
.pytest_tmp/
.pytest_cache_local/

# Hypothesis test data
.hypothesis/

# Test runtime artifacts (SQLite DBs created during tests)
config/test_*.db
config/skill_ratings.json

# Backup files
*.bak
web/app.py.bak

# Temporary debug/analysis files (generated during development, not for repo)
.tmp_external_agents/
tmp_*
*_log.txt
git_log_*.txt
diff_parser.txt
parser_history.txt
_test_run.txt
test_detail.txt
test_err.txt
fdadafc.txt
temp.txt
slide10.xml
fix_panel.py
fix_wa.py
fix_workspace.py

# License module with embedded key (only compiled .pyd ships)
app/core/llm/_license.py
