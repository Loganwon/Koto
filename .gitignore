# ===== Koto .gitignore =====

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
# Root build output only; do not ignore web/static/js/build bundles.
/build/*
/build/*.spec
# 例外：Inno Setup 中文语言文件需要随源码一起提交（CI 构建安装包依赖它）
!/build/ChineseSimplified.isl

# Virtual environment
.venv/
.venv-agent/
.venv-agent-bench/
.nodeenv/
venv/
env/

# Secrets & API keys
# Local credentials and generated state stay on disk, outside source publication.
**/.env
**/*.env
**/.env.*
**/*.env.*
!**/.env.example
!**/*.env.example
config/.builtin_key
config/jwt_secret.txt
config/email_accounts.json
config/context/user_background.json
config/memory_summaries.json
config/file_task_plans.json
config/file_task_followups.json
/.claude/settings.json
/web/workspace/test_edit_demo.txt
/uploads/
/.koto/
config/tests/suite_*.json
**/gemini_config.env
config/deepseek_config.env
app/core/config/user_settings.json
config/user_profile.json
config/memory.json
config/macro_suggestions.json
config/personality_matrix.json
config/token_usage.json
config/skill_bindings.json
config/model_setup_done.json
config/koto_checkpoints.sqlite*
config/local_model_prompted.json
web/config/jwt_secret.txt

# Runtime / personal data (generated at runtime, not for repo)
config/proactive_queue.json
config/shadow_observations.json
config/file_task_summaries.json
config/skill_usage_log.json
config/triggers.json
config/notifications.db
config/proactive_dialogue.db
config/proactive_triggers.db
config/insights.db
config/context_awareness.db
config/knowledge_graph.db
config/concepts.db
config/suggestions.db
config/user_behavior.db
/config/kb_config.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Logs
logs/
*.log

# Koto runtime temp files
_probe*.txt
_probe*.py
.koto_artifacts/
.koto.lock
.codex_runtime/
.tmp-debug*/
/tmp/
DS_KEY.txt
test_out.txt

# Stale backup files generated by scripts/remove_blueprint_routes.py
web/app.py.bak
test_output.txt
test_doc_output.txt
test_e2e.txt
build_log.txt

# Workspace user data at repo root only; web/src/workspace is frontend source.
/workspace/
/chats/

# Application-owned runtime state.  Keep the source directories visible; only
# ignore the locations populated by an interactive Koto run.
/app/core/chats/
/app/core/workspace/images/
/app/core/workspace/uploads/
/app/core/workspace/clipboard/history.json
/app/core/workspace/calendar/events.json
/app/core/workspace/reminders/reminders.json
/app/core/workspace/tasks/scheduled_tasks.json
config/auto_execution.db
config/user_settings.json
config/user_settings.json.lock
config/user_settings.json.corrupt-*

# One-off local diagnostics captured during the 2026-07 worktree inventory.
# These are deliberately exact names, rather than broad patterns, so fixtures
# and release assets remain reviewable by default.
/collapse_state.png
/expand_state.png
/screenshot_before.png
/debug_error.txt
/frontend_test_err.txt
/safe_test_files.txt
/temp_test_output.txt
/temp_test_result.txt
/test_stderr.txt
/test_stdout.txt
/unit_test_results.txt
/create_test.py
/temp_fix4.py

# Local migration/build evidence classified during the 2026-08 release freeze.
# Preserve these files on disk; exact rules prevent hiding real source assets.
/_test_screenshots/
/_col.txt
/deleted_files.txt
/fix_rag.py
/fix_rag_panel.py
/web/_npm_build.txt

# Models (large binary files)
models/
!web/models/
!web/models/*.py

# Build artifacts
_archive/
archive/build_logs/
archive/installer_backup/
*.zip
*.exe

# Large binary files
*.fst
*.mdl
*.pdf
*.pptx
*.docx
*.xlsx

# User auth data
config/users.json

# User uploads
web/uploads/*
!web/uploads/.gitkeep

# Node modules (if any)
node_modules/

# Large third-party debug map is reproducible from web/univer-editor.
# Keep the actual spreadsheet JS/CSS runtime assets in source control.
/web/static/univer-dist/assets/sheets-main.js.map

# WebView2 runtime profile
.webview2_profile/

# pytest local temp dirs
.pytest_tmp/
.pytest_cache_local/
/.pytest_*.xml
/.codex-runtime/
/.codex_tmp/

# Hypothesis test data
.hypothesis/

# Test runtime artifacts (SQLite DBs created during tests)
config/test_*.db
config/skill_ratings.json
config/token_usage.json
app/core/config/token_usage.json
config/memory_vectors.json
tests/e2e/screenshots/*.png

# Backup files
*.bak
web/app.py.bak

# Temporary debug/analysis files (generated during development, not for repo)
.tmp_external_agents/
_codex_*_clone/
tmp_*
*_log.txt
git_log_*.txt
diff_parser.txt
parser_history.txt
_test_run.txt
test_detail.txt
test_err.txt
fdadafc.txt
temp.txt
slide10.xml
fix_panel.py
fix_wa.py
fix_workspace.py

# License module with embedded key (only compiled .pyd ships)
app/core/llm/_license.py

# Vector index files (large binary)
*.faiss
config/file_rag_index/
config/memory_rag_index/
/config/rag_index/

# Training data (large, generated)
config/training_data/

# Database files
config/work_file_library.db
/web/config/work_file_library.db
/web/workspace/_index/

# Cython build cache
/build/cython_cache/

# Coverage reports
coverage_html/
coverage.xml
.coverage


# Server logs
server_*.log
srv_*.log

# Runtime data (moved from config/)
data/*.json
/data/*.json.bak
/data/calendar/
/data/auth/
/data/reminders/
/data/secrets/
/data/tasks/
data/db/*.db
/data/db/*.sqlite*
/data/file_rag_index/
/data/rag_index/
!data/README.md

# SQLite WAL/SHM (runtime artifacts)
*.sqlite-wal
*.sqlite-shm
