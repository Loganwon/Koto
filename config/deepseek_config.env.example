# Koto DeepSeek Configuration
# Copy this file to config/deepseek_config.env and fill in your API key
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional: customize model
# DEEPSEEK_MODEL=deepseek-chat
# Optional: enable thinking/reasoning (default: true)
# DEEPSEEK_ENABLE_THINKING=true
# Optional: reasoning effort level (low/medium/high, default: high)
# DEEPSEEK_REASONING_EFFORT=high
# Optional: max tokens per response (default: 8192)
# DEEPSEEK_MAX_TOKENS=8192
# Optional: API call timeout in seconds (default: 120)
# DEEPSEEK_CALL_TIMEOUT=120
