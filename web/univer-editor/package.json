{
  "name": "koto-univer-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Koto 文件助手 — Univer Canvas + AI 全双工文档编辑器",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:editor && npm run build:sheets && npm run clean:assets",
    "build:editor": "vite build",
    "build:sheets": "esbuild sheets-main.js --bundle --outdir=../static/univer-dist/assets --entry-names=[name] --format=iife --loader:.css=css --minify --sourcemap \"--define:__VUE_OPTIONS_API__=true\" \"--define:__VUE_PROD_DEVTOOLS__=false\" \"--define:__VUE_PROD_HYDRATION_MISMATCH_DETAILS__=false\"",
    "clean:assets": "node ./scripts/clean-univer-dist-assets.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@univerjs/core": "^0.5.0",
    "@univerjs/design": "^0.5.0",
    "@univerjs/docs": "^0.5.0",
    "@univerjs/docs-ui": "^0.5.0",
    "@univerjs/engine-formula": "^0.5.5",
    "@univerjs/engine-render": "^0.5.0",
    "@univerjs/facade": "^0.5.0",
    "@univerjs/sheets": "^0.5.5",
    "@univerjs/sheets-formula": "^0.5.5",
    "@univerjs/sheets-formula-ui": "^0.5.5",
    "@univerjs/sheets-ui": "^0.5.5",
    "@univerjs/ui": "^0.5.0",
    "esbuild": "^0.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "^7.8.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
