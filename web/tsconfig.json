{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "outDir": "./static/js/dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationDir": "./static/js/types",
    "sourceMap": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@workspace/*": ["workspace/*"],
      "@chat/*": ["chat/*"],
      "@skills/*": ["skills/*"],
      "@review/*": ["review/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "static", "univer-editor", "tiptap-editor"]
}
