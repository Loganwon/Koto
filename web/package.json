{
  "name": "koto-web",
  "version": "1.7.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build-bundles.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:staged": "eslint --fix",
    "precommit": "npm run lint && npm test && npm run typecheck",
    "coverage:py": "python -m pytest tests/test_settings.py --cov=web --cov=app --cov-report=term --cov-report=html:../coverage_html -q",
    "coverage:js": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.61.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@types/d3": "^7.4.0",
    "@types/marked": "^6.0.0"
  }
}
